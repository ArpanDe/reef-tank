<?xml version="1.0" encoding="utf-8"?>
<!-- One creature: a fish, a school of small fish, a drifter (seahorse), a
     critter walking on the reef floor, or a visitor that crosses the tank once
     and then sets `finished`. -->
<component name="Fish" extends="Group">
    <interface>
        <!-- { spec, uid, depthScale, tintRGB, opacity, schoolSize, bounds: [xMin, yMin, xMax, yMax], floorSpeed }
             For critters, bounds' y range is where their feet stand, and floorSpeed is the floor's scroll speed. -->
        <field id="config" type="assocarray" />
        <field id="finished" type="boolean" value="false" />
        <!-- Night darkening as a multiply on every part (set by the scene). -->
        <field id="nightRGB" type="floatarray" value="[1.0, 1.0, 1.0]" onChange="applyTint" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/util.brs" />
    <script type="text/brightscript" uri="pkg:/components/Fish.brs" />
    <!-- Swimming and turning animate this node's own translation and scale
         (fieldToInterp is set to "<uid>.translation" / "<uid>.scale" in
         onConfig). Moving an inner group instead wasn't redrawn mid-swim in
         brs-engine: the fish jumped at the end of each swim. -->
    <children>
        <Animation id="moveAnim" easeFunction="inOutQuad" repeat="false">
            <Vector2DFieldInterpolator id="moveInterp" />
        </Animation>
        <!-- Turning around: squash narrow, swap to the other-facing art, stretch
             back. Roku can't mirror an image with a negative scale (it moves
             child images but doesn't flip them), so scale stays positive and
             left-facing art is pre-mirrored at build time. -->
        <Animation id="turnOut" duration="0.3" easeFunction="inQuad" repeat="false">
            <Vector2DFieldInterpolator id="turnOutInterp" key="[0.0, 1.0]" />
        </Animation>
        <Animation id="turnIn" duration="0.3" easeFunction="outQuad" repeat="false">
            <Vector2DFieldInterpolator id="turnInInterp" key="[0.0, 1.0]" />
        </Animation>
        <Timer id="pauseTimer" repeat="false" />
    </children>
</component>
