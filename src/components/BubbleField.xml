<?xml version="1.0" encoding="utf-8"?>
<!-- Bubbles rising from the reef. 12 bubbles on 3 looping Animations of
     different lengths: no script runs once they start. Each bubble drifts left
     at the floor's scroll speed as it rises. -->
<component name="BubbleField" extends="Group">
    <interface>
        <!-- { bubbles: [textures small..large], floorY, speed } -->
        <field id="config" type="assocarray" onChange="onConfig" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/util.brs" />
    <script type="text/brightscript" uri="pkg:/components/BubbleField.brs" />
</component>
