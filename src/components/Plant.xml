<?xml version="1.0" encoding="utf-8"?>
<!-- A swaying plant: a chain of nested segment groups. Each rotates a little
     around its base with a phase lag, so the sway builds up the stem. -->
<component name="Plant" extends="Group">
    <interface>
        <!-- { plant: { segments, overlap, sway }, x, baseY, period, phase, uid } -->
        <field id="config" type="assocarray" onChange="onConfig" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/util.brs" />
    <script type="text/brightscript" uri="pkg:/components/Plant.brs" />
</component>
