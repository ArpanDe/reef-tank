# Copy to .env (gitignored) and fill in.
# Your Roku's LAN IP (Settings > Network > About) with Developer Mode enabled.
ROKU_HOST=192.168.1.50
# The password you chose when enabling Developer Mode (web installer user is "rokudev").
ROKU_PASSWORD=
# Only needed for `npm run package` (Channel Store build). Set after running `genkey` on the device.
ROKU_SIGNING_PASSWORD=
